@page "/plant/{Id:int}"
@using Sunflower.Helpers
@inject NavigationManager Navigation
@inject PlantService PlantService
@inject WishlistService WishlistService
@rendermode InteractiveServer


<div class="plant-details-container">


    @* Shows a loading message while the plant data is being fetched *@
    @if (plant == null)
    {
        <p>Loading...</p>
    }
    else
    {
        @* Button to go back to the gallery *@
        <button class="back-button" @onclick="GoBackToGallery">
            ← Back to Gallery
        </button>

        @* Plant name as the main title *@

        <h2>@CapitalizeHelper.CapitalizeName(plant.Common_Name)</h2>

        @* Main content of the page: image + information *@
        <div class="plant-details-content">

            @* Plant image *@
            <img src="@(!string.IsNullOrWhiteSpace(plant.Default_Image?.Medium_Url) 
                        ? plant.Default_Image.Medium_Url 
                        : "/img/noImage.jpg")"
                 alt="@plant.Common_Name"
                 class="plant-image" />

            @* Detailed plant information *@
            <div class="plant-info">
                <p><strong>Family:</strong> @plant.Family</p>
                <p><strong>Type:</strong> @plant.Type</p>
                <p><strong>Watering:</strong> @plant.Watering</p>
                <p><strong>Sunlight:</strong> @string.Join(", ", plant.Sunlight)</p>
                <p><strong>Maintenance:</strong> @plant.Maintenance</p>
                <p><strong>Medicinal:</strong> @(plant.Medicinal ? "Yes" : "No")</p>
                <p><strong>Poisonous to humans:</strong> @(plant.Poisonous_To_Humans ? "Yes" : "No")</p>
                <p><strong>Description:</strong></p>
                <p class="plant-description">@plant.Description</p>
            </div>
        </div>

        @* <button class="wishlist-button" @onclick="AddToWishlist">
            Add to Wishlist
        </button> *@

        <button class="wishlist-button" disabled="@isAdding"@onclick="AddToWishlist">
            @buttonText
        </button>

    }
</div>

@code {
    // Parameter received from the URL, used to fetch plant details
    [Parameter]
    public int Id { get; set; }

    private PlantDetailsResponse? plant;

    protected override async Task OnInitializedAsync()
    {
        plant = await PlantService.GetPlantDetailsAsync(Id);
    }

    // Function to navigate back to the gallery page
    private void GoBackToGallery()
    {
        Navigation.NavigateTo("/gallery");
    }

    // Function to capitalize the first letter of each word
    private string CapitalizeName(string name)
    {
        if (string.IsNullOrEmpty(name))
            return "";

        var words = name.Split(' ');
        for (int i = 0; i < words.Length; i++)
        {
            if(words[i].Length > 0)
                words[i] = char.ToUpper(words[i][0]) + words[i].Substring(1).ToLower();
        }
        return string.Join(' ', words);
    }

    @* private async Task AddToWishlist()
    {
        if (plant == null)
            return;

        var wishlistItem = new WishlistItem
        {
            PlantId = plant.Id,
            Name = plant.Common_Name,
            ImageUrl = plant.Default_Image?.Medium_Url,
            Family = plant.Family,
            Type = plant.Type,
            Watering = plant.Watering,
            Sunlight = plant.Sunlight,
            Maintenance = plant.Maintenance,
            Medicinal = plant.Medicinal,
            Poisonous_To_Humans = plant.Poisonous_To_Humans,
            Description = plant.Description
        };

        await WishlistService.AddToWishlistAsync(wishlistItem);
    } *@

    private bool isAdding = false;
    private string buttonText = "Add to Wishlist";

    private async Task AddToWishlist()
    {
        if (plant == null)
            return;

        // Build wishlist item
        var wishlistItem = new WishlistItem
        {
            PlantId = plant.Id,
            Name = plant.Common_Name,
            ImageUrl = plant.Default_Image?.Medium_Url
        };

        await WishlistService.AddToWishlistAsync(wishlistItem);

        // Flash success message
        isAdding = true;
        buttonText = "✓ Added!";
        StateHasChanged();

        // Wait 1.5 seconds before resetting
        await Task.Delay(1500);

        buttonText = "Add to Wishlist";
        isAdding = false;
    }

}