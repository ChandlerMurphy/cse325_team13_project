@* @page "/"
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthProvider
@implements IDisposable
@rendermode InteractiveServer

<PageTitle>Home</PageTitle>

<div class="main">
    <p>
        @if (!string.IsNullOrEmpty(userName))
        {
            <span>Welcome, @userName!</span>
        }
        else
        {
            <span>You are not logged in.</span>
        }
    </p>

    <div class="homepage">

        <!-- Hero Section -->
        <section class="hero text-center py-5">
            <h1 class="display-4 fw-bold">Welcome to The Sunflower</h1>
            <p class="mt-3">
                Your local flower shop—now online. Explore our fresh, vibrant blooms, 
                learn fun flower facts, and stay up to date with everything happening at our store.
            </p>
            <a href="products" class="btn btn-primary btn-lg mt-3">Explore Our Products</a>
        </section>

        <!-- About the Shop -->
        <section class="container py-5">
            <div class="row align-items-center">
                <div class="col-md-6">
                    <h2>Bringing Flowers & Community Together</h2>
                    <p>
                        At <strong>The Sunflower</strong>, we believe flowers brighten life’s simple moments. 
                        Our mission is to make discovering your perfect flower easy and enjoyable. 
                        Through this site, you can browse our collection, learn about each flower’s 
                        unique details, and stay connected with us—anytime, anywhere.
                    </p>
                    <p>
                        Whether you’re a returning customer or visiting us for the first time, 
                        we’re excited to share the beauty and stories behind the blooms we sell.
                    </p>
                </div>
                <div class="col-md-6 text-center">
                    <img src="/img/logo-1.png" class="img-fluid rounded shadow" alt="Flower assortment" />
                </div>
            </div>
        </section>

        <!-- Features / Sections Overview -->
        <section class="bg-light py-5">
            <div class="container">
                <h2 class="text-center mb-4">What You'll Find on Our Site</h2>

                <div class="row g-4">
                    <div class="col-md-4">
                        <div class="p-4 bg-white rounded shadow-sm h-100">
                            <h4>🌼 Flower Catalog</h4>
                            <p>
                                Browse our full collection of flowers. View descriptions, fun facts, 
                                and availability—all supported by our regularly updated database.
                            </p>
                            <a href="dictionary" class="btn btn-outline-primary">View Flowers</a>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="p-4 bg-white rounded shadow-sm h-100">
                            <h4>💛 Wishlist & Profiles</h4>
                            <p>
                                Create an account to save your favorite flowers, build a personal wishlist, 
                                and make planning your next visit easier than ever.
                            </p>
                            <a href="register" class="btn btn-outline-primary">Create Profile</a>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="p-4 bg-white rounded shadow-sm h-100">
                            <h4>🌻 Events & Store News</h4>
                            <p>
                                Stay up to date with seasonal events, special sales, and community activities 
                                hosted by The Sunflower's staff and owners.
                            </p>
                            <a href="events" class="btn btn-outline-primary">View Events</a>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Mission Statement -->
        <section class="container py-5">
            <div class="text-center">
                <h2>More Than a Flower Shop</h2>
                <p class="mt-3">
                    This website helps us connect with you better by using modern <strong>.NET technologies</strong> 
                    to deliver a simple, fast, and meaningful digital experience.  
                    Our goal is to provide not just products, but knowledge, inspiration, 
                    and a closer connection to our community.
                </p>
            </div>
        </section>

        <!-- Call to Action -->
        <section class="text-center py-5 bg-warning bg-opacity-25">
            <h3 class="fw-semibold">Ready to Discover Your Favorite Flower?</h3>
            <p class="mb-4">Browse our collection or register to start saving your top picks.</p>
            <a href="/Flowers" class="btn btn-primary btn-lg me-2">Explore Flowers</a>
            <a href="/Account/Register" class="btn btn-outline-primary btn-lg">Create Profile</a>
        </section>

    </div>
</div>

@code {
    private string? userName;

    protected override async Task OnInitializedAsync()
    {
        // Subscribe to auth state changes
        AuthProvider.AuthenticationStateChanged += OnAuthenticationStateChanged;

        // Initial check
        await UpdateUserNameAsync();
    }

    private async Task UpdateUserNameAsync()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated ?? false)
        {
            // Use Name claim from JWT
            userName = user.Identity.Name ?? user.FindFirst(c => c.Type == ClaimTypes.Name)?.Value;
        }
        else
        {
            userName = null;
        }

        StateHasChanged();
    }

    private async void OnAuthenticationStateChanged(Task<AuthenticationState> task)
    {
        await UpdateUserNameAsync();
    }

    public void Dispose()
    {
        // Unsubscribe to prevent memory leaks
        AuthProvider.AuthenticationStateChanged -= OnAuthenticationStateChanged;
    }
} *@





