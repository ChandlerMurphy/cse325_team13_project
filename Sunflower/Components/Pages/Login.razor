            if (loginResponse == null || string.IsNullOrEmpty(loginResponse.Token))
            {
                error = "Login failed: Invalid response from server.";
                return;
            }

            // ✅ Safe JSInterop: only now can we call localStorage
            await JS.InvokeVoidAsync("localStorage.setItem", "jwtToken", loginResponse.Token);

            // ✅ Update authentication state
            AuthStateProvider.NotifyUserAuthentication(
                new User
                {
                    Username = loginResponse.Username,
                    Role = loginResponse.Role
                }
            );

            // ✅ Navigate to home page
            Nav.NavigateTo("/");
        }
        catch (Exception ex)
        {
            error = $"Login failed: {ex.Message}";
        }
    }

    private class LoginRequest
    {
        public string Username { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
    }

    private class LoginResponse
    {
        public string Token { get; set; } = string.Empty;
