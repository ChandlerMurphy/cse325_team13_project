@page "/logout"
@inject IJSRuntime JS
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>Logout</PageTitle>

<h2>Logout</h2>

<p>Are you sure you want to logout?</p>

<button class="logout-button" @onclick="ConfirmLogout">Yes, Logout</button>
<button class="cancel-button" @onclick="CancelLogout">Cancel</button>

@code {
    private async Task ConfirmLogout()
    {
        // Remove the token from local storage
        await JS.InvokeVoidAsync("localStorage.removeItem", "SunflowerToken");

        // Redirect to home page
        Navigation.NavigateTo("/", true);
    }

    private void CancelLogout()
    {
        // Simply navigate back to home or previous page
        Navigation.NavigateTo("/", true);
    }
}
